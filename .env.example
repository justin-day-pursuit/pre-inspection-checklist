# ------------------------------------------------------------
# Copy this file to `.env.local` and paste your real secrets there.
#
#   cp .env.example .env.local
#
# NEVER commit `.env.local` — it holds your secret keys.
# ------------------------------------------------------------

# Google Gemini (optional for AI features later)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------
# NYC Open Data (SODA3) — Open HPD Violations dataset
# Dataset view: csn4-vhvf
# Endpoint used by the app:
#   https://data.cityofnewyork.us/api/v3/views/csn4-vhvf/query.json
#
# App Token is required for SODA3 queries.
# Create one after signing in to NYC Open Data / Socrata.
# Username + password are optional Basic Auth for your account.
# ------------------------------------------------------------
NYC_OPENDATA_APP_TOKEN=
NYC_OPENDATA_USERNAME=
NYC_OPENDATA_PASSWORD=
NYC_OPENDATA_BASE_URL=https://data.cityofnewyork.us/api/v3/views/csn4-vhvf/query.json
